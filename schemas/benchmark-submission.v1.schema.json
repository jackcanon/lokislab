{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lokislab.org/schemas/benchmark-submission.v1.schema.json",
  "title": "Loki's Lab benchmark submission",
  "description": "Portable submission envelope for a versioned local-agent benchmark run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "created_at",
    "suite",
    "harness",
    "system",
    "model",
    "configuration",
    "runs"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "submission_id": {
      "type": "string",
      "pattern": "^LL-[A-Z0-9][A-Z0-9-]{5,63}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "profile"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["computer_description", "os", "os_version", "architecture", "memory_gb"],
      "properties": {
        "computer_description": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "enum": ["macOS", "Linux", "Windows"] },
        "os_version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "enum": ["arm64", "x86_64"] },
        "cpu": { "type": "string" },
        "gpu": { "type": ["string", "null"] },
        "memory_gb": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "name", "version"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "publisher_recommended",
            "lokis_lab_tuned",
            "custom_quantization",
            "custom_context_or_tools",
            "other_custom"
          ]
        },
        "settings": { "type": "object" },
        "notes": { "type": "string" }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "nullableScore": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "category",
        "run_number",
        "capable",
        "skipped",
        "quality",
        "accuracy",
        "speed_seconds",
        "total_wall_seconds",
        "raw_output",
        "notes",
        "tested_at"
      ],
      "properties": {
        "test_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "run_number": { "type": "integer", "minimum": 1, "maximum": 3 },
        "capable": { "type": "boolean" },
        "skipped": { "type": "boolean" },
        "quality": { "$ref": "#/$defs/nullableScore" },
        "accuracy": { "$ref": "#/$defs/nullableScore" },
        "speed_seconds": { "type": "number", "minimum": 0 },
        "total_wall_seconds": { "type": "number", "minimum": 0 },
        "auto_scored": { "type": "boolean" },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "raw_output": { "type": "string" },
        "notes": { "type": "string" },
        "tested_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
