{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {},
  "headers": [
    {
      "source": "/eval/(.*)\\.sh$",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-sh"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}